{
  "name": "maxwell-scores",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "maxwell-scores",
    "database_id": "16ea53e9-dc76-4dd0-8e7a-a177f90949a4",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "WRITE_LIMIT",
    "namespace_id": "10791",
    "simple": { "limit": 120, "period": 60 }
  }],
  "triggers": { "crons": ["19 3 * * *"] }
}
